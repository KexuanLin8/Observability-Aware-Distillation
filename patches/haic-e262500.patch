+class robot_heading_err_imu(RobotTrackObservation):
+    """Robot heading error w.r.t. the reference root, as an onboard gyro integrator reports it.
+
+    Deployment model: at episode start the reference frame is aligned to the robot, then the
+    heading is propagated by integrating the IMU yaw rate. The measured error is therefore the
+    true heading error plus an integration error that starts at an alignment error and grows with
+    the gyro bias (episodic offset + random walk) and white rate noise:
+        err_0 ~ N(0, init_align_std),  bias_0 ~ N(0, bias_std)
+        bias  += N(0, bias_rw_std) * sqrt(dt)
+        err   += (bias + N(0, rate_noise_std)) * dt
+        e_meas = wrap(yaw_robot + err - yaw_ref)
+    Returns [cos e_meas, sin e_meas]. zero_info=True returns the constant [1, 0] (zero information,
+    identical network inputs' shape) for the capacity control. A dedicated generator keeps the
+    environment's own random streams unchanged.
+    """
+    def __init__(self, init_align_std: float = 0.01, bias_std: float = 0.002, bias_rw_std: float = 0.0005,
+                 rate_noise_std: float = 0.005, seed: int = 0, zero_info: bool = False, **kwargs):
+        super().__init__(**kwargs)
+        self.init_align_std, self.bias_std = init_align_std, bias_std
+        self.bias_rw_std, self.rate_noise_std = bias_rw_std, rate_noise_std
+        self.zero_info = zero_info
+        self._gen = torch.Generator(device=self.device)
+        self._gen.manual_seed(int(seed) + 47193)
+        self.err = torch.zeros(self.num_envs, device=self.device)
+        self.bias = torch.zeros(self.num_envs, device=self.device)
+        self.value = torch.zeros(self.num_envs, 2, device=self.device)
+        self.value[:, 0] = 1.0
+
+    def _randn(self, n):
+        return torch.randn(n, generator=self._gen, device=self.device)
+
+    def reset(self, env_ids):
+        n = len(env_ids)
+        self.err[env_ids] = self._randn(n) * self.init_align_std
+        self.bias[env_ids] = self._randn(n) * self.bias_std
+
+    def update(self):
+        dt = self.env.step_dt
+        self.bias += self._randn(self.num_envs) * (self.bias_rw_std * dt ** 0.5)
+        self.err += (self.bias + self._randn(self.num_envs) * self.rate_noise_std) * dt
+        e = wrap_to_pi(yaw_from_quat(self.command_manager.robot_root_quat_w) + self.err
+                       - yaw_from_quat(self.command_manager.ref_root_quat_w))
+        self.value = torch.stack([torch.cos(e), torch.sin(e)], dim=-1)
+
+    def compute(self):
+        if self.zero_info:
+            out = torch.zeros(self.num_envs, 2, device=self.device)
+            out[:, 0] = 1.0
+            return out
+        return self.value
+
